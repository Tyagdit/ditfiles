[user]
    name = Tyagraj Desigar
    useConfigOnly = true
[includeIf "gitdir:~/unifize/"]
    path = "./unifize_config"
[includeIf "gitdir:~/personal/"]
    path = "./personal_config"
[core]
    editor = nvim
[help]
    autocorrect = prompt
[push]
    autoSetupRemote = true
[diff]
    tool = nvimdiff
    colorMoved = plain
    renames = true
    algorithm = histogram
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[difftool]
    prompt = true
[alias]
    olog = log --graph --oneline
    acommit = !"git add -A && git commit -am"
    co = checkout
    nbranch = checkout -b
    rbranch = branch -d
    aadd = add -Av
    amend = commit --amend --no-edit
    ostatus = status -sb --ahead-behind
    unstage = rm --cached
[format]
    pretty = short
[advice]
    statusHints = false
[init]
    defaultBranch = master
[rerere]
    enabled = true
    autoupdate = true
